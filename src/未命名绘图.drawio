        <mxCell id="1" parent="0" />
        <mxCell id="kzQoymH5NH3FHjtcJcsb-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" value="AIHNET-Provider 用户角色与权限矩阵" vertex="1">
          <mxGeometry height="40" width="800" x="582" y="227" as="geometry" />
        </mxCell>
        <mxCell id="kzQoymH5NH3FHjtcJcsb-2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="基于 src/ 源码分析 | 认证方式：Auth0 OAuth | 后端 API：myaih.net" vertex="1">
          <mxGeometry height="25" width="800" x="582" y="262" as="geometry" />
        </mxCell>
        <mxCell id="kzQoymH5NH3FHjtcJcsb-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" value="⚠ 代码现状说明&#xa;本仓库为纯前端 Provider 门户，未实现 RBAC（基于角色的访问控制）。&#xa;不存在「商家」「超级管理员」等角色枚举；仅有 Auth0 二元认证：未登录 / 已登录。&#xa;路由无 beforeEach 守卫，所有页面 URL 均可直接访问；部分功能通过 isAuthenticated 软限制。" vertex="1">
          <mxGeometry height="70" width="1520" x="222" y="297" as="geometry" />
        </mxCell>
        <mxCell id="kzQoymH5NH3FHjtcJcsb-4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#2c3e50;" value="一、系统角色定义（代码层面）" vertex="1">
          <mxGeometry height="30" width="400" x="222" y="382" as="geometry" />
        </mxCell>
        <mxCell id="kzQoymH5NH3FHjtcJcsb-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#dc3545;fontSize=11;align=left;spacingLeft=10;spacingTop=4;fontStyle=0;" value="未登录访客&#xa;(Guest)&#xa;&#xa;• 无 Auth0 会话&#xa;• store.state.user = null&#xa;• 无 Bearer Token" vertex="1">
          <mxGeometry height="110" width="240" x="222" y="417" as="geometry" />
        </mxCell>
        <mxCell id="kzQoymH5NH3FHjtcJcsb-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=11;align=left;spacingLeft=10;spacingTop=4;fontStyle=0;" value="已登录 Provider&#xa;(医疗提供商)&#xa;&#xa;• Auth0 认证通过&#xa;• user.sub 作为 UUID&#xa;• QR 码前缀 provideruuid:&#xa;• 产品定位：管理关注患者" vertex="1">
          <mxGeometry height="110" width="260" x="482" y="417" as="geometry" />
        </mxCell>
        <mxCell id="kzQoymH5NH3FHjtcJcsb-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e3e5;strokeColor=#6c757d;fontSize=11;align=left;spacingLeft=10;spacingTop=4;fontStyle=2;" value="Patient（患者）&#xa;【非本系统角色】&#xa;&#xa;• 独立门户：medical.aihnet.com/aih-patient/&#xa;• 本仓库仅作为聊天对象出现&#xa;• 无登录入口、无路由权限" vertex="1">
          <mxGeometry height="110" width="300" x="762" y="417" as="geometry" />
        </mxCell>
        <mxCell id="kzQoymH5NH3FHjtcJcsb-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#adb5bd;fontSize=11;align=left;spacingLeft=10;spacingTop=4;dashed=1;dashPattern=8 4;" value="❌ 代码中不存在的角色&#xa;&#xa;• 普通用户（与 Provider 未区分）&#xa;• 商家 / Merchant&#xa;• 超级管理员 / Admin&#xa;• 任何 UserRole / Permission 枚举" vertex="1">
          <mxGeometry height="110" width="300" x="1082" y="417" as="geometry" />
        </mxCell>
        <mxCell id="kzQoymH5NH3FHjtcJcsb-9" parent="1" style="swimlane;startSize=25;fillColor=#f0f4f8;strokeColor=#4a90d9;fontStyle=1;fontSize=12;" value="图例" vertex="1">
